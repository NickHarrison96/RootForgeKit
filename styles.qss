/* ============================================================
   RootForgeKit — Modern Dark Mode Stylesheet (3uTools-Inspired)
   Color Palette:
     Background:    #0d1117, #161b22, #1a1f2e
     Surface/Cards: #1c2333, #21283b
     Borders:       #30363d
     Accent:        #00e5ff (cyan), #536dfe (indigo), #00e676 (green)
     Text:          #e6edf3 (primary), #8b949e (secondary)
     Danger:        #ff5252
     Warning:       #ffc107
   ============================================================ */

/* ---- Global ---- */
QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Helvetica Neue", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0d1117;
}

/* ============================================================
   PERSISTENT STATUS BAR (always visible)
   ============================================================ */

QStatusBar#PersistentStatusBar {
    background-color: #0b0e14;
    border-top: 1px solid #1c2333;
    padding: 0px 4px;
    min-height: 30px;
    max-height: 32px;
}

QStatusBar#PersistentStatusBar QLabel {
    background-color: transparent;
    padding: 0px 4px;
    font-size: 11px;
}

QWidget#StatusRightWidget {
    background-color: transparent;
}

QWidget#StatusContainer,
QWidget#StatusOpWidget {
    background-color: transparent;
}

QLabel#StatusOpLabel {
    background-color: transparent;
    font-size: 11px;
}

/* Centre-of-bar operation progress. The chunk colour matches the cyan used
   for in-flight captions; the bar itself sits on the same near-black the
   status bar uses so it reads as part of the bar, not a floating widget. */
QProgressBar#StatusBarProgress {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}

QProgressBar#StatusBarProgress::chunk {
    background-color: #00e5ff;
    border-radius: 2px;
}

/* ============================================================
   TAB WIDGET
   ============================================================ */

QTabWidget::pane {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-top: 2px solid #00e5ff;
}

QTabBar {
    background-color: #161b22;
}

QTabBar::tab {
    background-color: #161b22;
    color: #8b949e;
    padding: 10px 24px;
    margin-right: 2px;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
}

QTabBar::tab:hover {
    background-color: #1c2333;
    color: #e6edf3;
}

QTabBar::tab:selected {
    background-color: #1a1f2e;
    color: #00e5ff;
    border-bottom: 3px solid #00e5ff;
}

/* ============================================================
   SCROLL AREAS & SCROLL BARS
   ============================================================ */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #161b22;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
    background-color: #161b22;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484f58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* ============================================================
   BUTTONS (general)
   ============================================================ */

QPushButton {
    background-color: #21283b;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #2d333b;
    border-color: #00e5ff;
    color: #00e5ff;
}

QPushButton:pressed {
    background-color: #0d1117;
    border-color: #00e5ff;
}

QPushButton:disabled {
    background-color: #161b22;
    color: #484f58;
    border-color: #21283b;
}

/* ============================================================
   LINE EDITS (general)
   ============================================================ */

QLineEdit {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #264f78;
}

QLineEdit:focus {
    border-color: #00e5ff;
    background-color: #1c2333;
}

/* ============================================================
   PROGRESS BARS
   ============================================================ */

QProgressBar {
    background-color: #21283b;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #e6edf3;
    font-size: 10px;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00e5ff, stop:0.5 #536dfe, stop:1 #00e676
    );
    border-radius: 6px;
}

QProgressBar#RamBar {
    background-color: #30363d;
    border-radius: 6px;
    max-height: 12px;
}

/* ============================================================
   LABELS
   ============================================================ */

QLabel {
    background-color: transparent;
    color: #e6edf3;
}

QLabel#TabSectionTitle { color: #00e5ff; }
QLabel#TabSubtitle     { color: #8b949e; }

QLabel#InfoKey {
    color: #00e5ff;
    background-color: transparent;
    padding: 4px 0px;
}

QLabel#InfoValue {
    color: #c9d1d9;
    background-color: transparent;
    padding: 4px 0px;
}

/* ============================================================
   FRAMES / CARDS
   ============================================================ */

QFrame {
    background-color: transparent;
    border: none;
}

/* ---- Overview Left Panel ---- */
QFrame#OverviewLeftPanel {
    background-color: #151c28;
    border: 1px solid #2d3c52;
    border-radius: 10px;
}

/* OS identity block (Overview left panel) */
QLabel#OsLogo          { background-color: transparent; }
QLabel#OverviewHost    { background-color: transparent; color: #00f0ff; }
QLabel#OverviewPlatform{ background-color: transparent; color: #d8e2ed; }

/* ---- Spec Cards & Phone-Style Widgets (right panel) ---- */
/* Clearly lifted off the near-black page bg (#0d1117) so each widget reads as
   its own raised card instead of white text on a black void. Kept a visible
   step above the page on purpose — a subtler navy was imperceptible in
   practice. Hover/drag states step up one more level again. */
QFrame#SpecCard {
    background-color: #2c3d5c;
    border: 1px solid #45597e;
    border-radius: 10px;
}

QFrame#SpecCard:hover {
    border-color: #00f0ff;
    background-color: #364a6d;
}

QFrame#SpecCard[dragTarget="true"] {
    border: 2px dashed #00f0ff;
    background-color: #33507c;
}

/* The card's inner header + body are plain QWidgets, so without this they
   inherit the global `QWidget { background-color: #0d1117 }` rule and paint the
   page color straight over the card fill -- which made the cards look
   transparent no matter what SpecCard background was set to. Force them
   transparent so the card surface actually shows through behind the text. */
QWidget#WidgetHeader,
QWidget#WidgetBody {
    background-color: transparent;
}

QLabel#SpecCardTitle   { color: #ffffff; font-weight: bold; }
QLabel#SpecCardContent { color: #ffffff; }

QLabel#WidgetDragHandle {
    color: #8fa4be;
    font-size: 14px;
    font-weight: bold;
    padding-right: 2px;
}

QLabel#WidgetDragHandle:hover {
    color: #00f0ff;
}

QPushButton#WidgetMiniBtn {
    background-color: transparent;
    border: none;
    color: #8fa4be;
    font-size: 11px;
    font-weight: bold;
    padding: 0px 3px;
}

QPushButton#WidgetMiniBtn:hover {
    background-color: transparent;
    border: none;
    color: #00f0ff;
}

QPushButton#WidgetMiniBtn:pressed {
    background-color: transparent;
    border: none;
    color: #ffffff;
}

QPushButton#ResetLayoutBtn {
    background-color: #233247;
    border: 1px solid #3d506e;
    border-radius: 6px;
    color: #ffffff;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#ResetLayoutBtn:hover {
    border-color: #00f0ff;
    color: #0b1017;
    background-color: #00f0ff;
}

/* ============================================================
   TERMINAL CONSOLE WIDGET
   ============================================================ */

QFrame#TerminalHeader {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-bottom: none;
    border-radius: 8px 8px 0px 0px;
}

QLabel#TerminalStatus {
    color: #4caf50;
    font-family: "Consolas", "Courier New", monospace;
}

QPlainTextEdit#TerminalConsole {
    background-color: #0a0e14;
    color: #39ff14;
    border: 1px solid #30363d;
    border-top: none;
    border-radius: 0px 0px 8px 8px;
    font-family: "Consolas", "Courier New", "Fira Code", monospace;
    font-size: 11px;
    padding: 10px;
    selection-background-color: #264f78;
}

QPushButton#TerminalBtn {
    background-color: #21283b;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
}

QPushButton#TerminalBtn:hover {
    background-color: #2d333b;
    color: #e6edf3;
    border-color: #484f58;
}

QPushButton#TerminalAbortBtn {
    background-color: #3d1117;
    color: #ff5252;
    border: 1px solid #ff5252;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
}

QPushButton#TerminalAbortBtn:hover { background-color: #5c1a1a; }
QPushButton#TerminalAbortBtn:disabled {
    background-color: #161b22;
    color: #484f58;
    border-color: #30363d;
}

/* ============================================================
   TOOL CARDS (Tech & Gamer Tabs)
   ============================================================ */

QFrame#ToolCard {
    background-color: #1c2333;
    border: 1px solid #30363d;
    border-radius: 10px;
}

QFrame#ToolCard:hover {
    border-color: #00e5ff;
    background-color: #21283b;
}

QLabel#ToolCardGlyph {
    background-color: transparent;
    color: #00e5ff;
}

QLabel#ToolCardName { color: #e6edf3; }
QLabel#ToolCardDesc { color: #8b949e; }

/* Visible outcome line under the description. The per-row colour is set
   inline from ToolCard.STATUS so it tracks the status glyph; this only
   supplies the base font and spacing. */
QLabel#ToolCardStatus {
    background-color: transparent;
    font-weight: 600;
}

QPushButton#ToolRunBtn {
    background-color: #21283b;
    color: #00e5ff;
    border: 1px solid #00e5ff;
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
    padding: 3px 6px;
}

QPushButton#ToolRunBtn:hover {
    background-color: #00e5ff;
    color: #0d1117;
}

QPushButton#ToolRunBtn:disabled {
    background-color: #161b22;
    border-color: #21283b;
    color: #484f58;
}

/* Risk rail on the left edge — same vocabulary the old compact buttons used,
   so a destructive action is recognisable at a glance. */
QPushButton#ToolRunBtn[risk="medium"] {
    border-left: 3px solid #ffc107;
}

QPushButton#ToolRunBtn[risk="medium"]:hover {
    background-color: rgba(255, 193, 7, 0.14);
    border-color: #ffc107;
    color: #ffc107;
}

QPushButton#ToolRunBtn[risk="high"] {
    border-left: 3px solid #ff5252;
}

QPushButton#ToolRunBtn[risk="high"]:hover {
    background-color: rgba(255, 82, 82, 0.14);
    border-color: #ff5252;
    color: #ff5252;
}

/* Header-row rescan of installed packages */
QPushButton#ToolRefreshBtn {
    background-color: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#ToolRefreshBtn:hover {
    background-color: #1c2333;
    border-color: #00e5ff;
    color: #00e5ff;
}

QPushButton#ToolRefreshBtn:disabled {
    background-color: #161b22;
    border-color: #21283b;
    color: #484f58;
}

/* ============================================================
   SPLITTER
   ============================================================ */

QSplitter::handle {
    background-color: #30363d;
    border-radius: 3px;
}

QSplitter::handle:horizontal { width: 10px; }
QSplitter::handle:vertical { height: 10px; }

QSplitter::handle:hover,
QSplitter::handle:pressed { background-color: #00e5ff; }

/* ============================================================
   MISC
   ============================================================ */

QLabel#TerminalSectionLabel { color: #8b949e; }

QToolTip {
    background-color: #1c2333;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}

QMessageBox {
    background-color: #161b22;
    color: #e6edf3;
}

QMessageBox QPushButton {
    min-width: 70px;
    padding: 4px 12px;
}

QGroupBox {
    background-color: #1c2333;
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    font-weight: 600;
    font-size: 11px;
    color: #e6edf3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #00e5ff;
}

/* ============================================================
   MOBILE TABS — quick action rows
   ============================================================ */

/* Quick action row buttons (Reboot, Refresh, etc.) */
QPushButton#MobileQuickBtn {
    background-color: #21283b;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#MobileQuickBtn:hover {
    background-color: #2d333b;
    border-color: #00e5ff;
    color: #00e5ff;
}

/* ============================================================
   COLLAPSIBLE SECTION
   ============================================================ */

QPushButton#CollapsibleHeader {
    background-color: #1c2333;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    text-align: left;
}

QPushButton#CollapsibleHeader:hover {
    background-color: #21283b;
    color: #e6edf3;
    border-color: #484f58;
}

QPushButton#CollapsibleHeader:checked {
    background-color: #161b22;
    color: #00e5ff;
    border-color: #00e5ff;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QFrame#CollapsibleContent {
    background-color: #161b22;
    border: 1px solid #00e5ff;
    border-top: none;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    padding: 4px 0px;
}
